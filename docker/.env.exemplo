# Copie para docker/.env e ajuste os caminhos (o scripts/instalar-docker.sh faz isso).

# Pasta com os dados do container (home, configurações, saves dos emuladores).
DADOS=/home/SEU_USUARIO/AllGames-docker
# Onde a Steam e a Epic instalam os jogos: use o disco com mais espaço.
JOGOS=/home/SEU_USUARIO/Jogos
# Jogos que você já baixou na Steam instalada direto no Pop!_OS: o container usa os mesmos
# arquivos, sem baixar de novo. Deixe vazio se não tiver. Não abra as duas Steams ao mesmo tempo.
STEAM_PC=
# Suas ROMs, uma pasta por console (snes, psx, ps2, switch...) e a BIOS em bios/.
# Pode ser a pasta "roms" copiada do cartão do R36S.
ROMS=/home/SEU_USUARIO/AllGames/roms

# Seu usuário no host (comando: id -u / id -g), para os arquivos ficarem seus.
PUID=1000
PGID=1000

# Placa de vídeo usada para rodar e transmitir (ls /dev/dri). Em PCs com duas
# placas, a dedicada costuma ser a renderD129.
GPU=/dev/dri/renderD128

# sim = tocar na tela do celular funciona como mouse (dá para tocar nas capas).
# nao = só o controle comanda (os botões de controle na tela do Moonlight continuam valendo):
#       tocar na tela não mexe o cursor.
TOQUE=sim
# O mesmo para a segunda sessão (a do PC, com teclado e mouse).
TOQUE_2=sim

# desktop = área de trabalho KDE (o portal AllGames abre por cima)
# gaming  = Steam em modo Big Picture
MODO=desktop
NOME=allgames
